{
    "name": "bartosznowak/github",
    "authors": [
        {
            "name": "bartnovak",
            "email": "b.nowak@osomstudio.com"
        }
    ],
    "require": {
        "squizlabs/php_codesniffer": "^3.13.4",
        "wp-coding-standards/wpcs": "3.4.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpcs --standard=WordPress-Extra --extensions=php ../web/app/themes --exclude=WordPress.Files.FileName -s",
        "set" : "phpcs --config-set installed_paths vendor/phpcsstandards/phpcsextra,vendor/phpcsstandards/phpcsutils,vendor/wp-coding-standards/wpcs"
    }
}
